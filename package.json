{
  "name": "saigevision-project-converter",
  "version": "0.0.3",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:workers": "node scripts/build-browser-workers.mjs",
    "build:notices": "node scripts/copy-public-notices.mjs",
    "build:assets": "npm run build:workers && npm run build:notices",
    "predev": "npm run build:assets",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run build:assets",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "postbuild": "node scripts/restore-next-env.mjs",
    "prebuild:pages": "npm run build:assets",
    "build:pages": "cross-env NEXT_TELEMETRY_DISABLED=1 GITHUB_PAGES_EXPORT=1 next build",
    "postbuild:pages": "node scripts/harden-static-html.mjs && node scripts/restore-next-env.mjs",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts tests/converter-ui-regression.test.mjs tests/release-tag-gate.test.mjs",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "npm run build:pages && npm run test:e2e:prepared",
    "test:e2e:prepared": "playwright test",
    "test:pages": "npm run build:pages && node --test tests/static-export.test.mjs",
    "check": "npm run verify:release && npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:render",
    "verify:release": "node scripts/verify-release-version.mjs",
    "verify:release:tag": "node scripts/verify-release-tag.mjs",
    "audit:dependencies": "node scripts/verify-npm-audit.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['.next', 'out']) rmSync(path, { recursive: true, force: true });\" && tsc --noEmit"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.8.60",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.3",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "image-size": "file:./vendor/image-size-2.0.3-saige.2.tgz",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.2.2",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "image-size": "$image-size"
  },
  "type": "module"
}
